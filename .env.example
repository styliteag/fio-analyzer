# FIO Analyzer Environment Configuration
# Copy this file to .env and adjust values as needed

# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Database Configuration
DATABASE_PATH=backend/db/storage_performance.db

# Authentication
AUTH_ADMIN_FILE=.htpasswd
AUTH_UPLOADER_FILE=.htuploaders

# CORS: browser origins that may call the API with the session cookie (comma-separated).
# Never "*": with credentials that lets any website read API responses. Empty = same origin only.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Browser sessions
SESSION_LIFETIME_HOURS=48
# auto | true | false (set true behind HTTPS)
COOKIE_SECURE=auto

# Development Settings
DEBUG=false
LOG_LEVEL=INFO

# Upload Settings
MAX_UPLOAD_SIZE=50MB
UPLOAD_DIR=backend/uploads

# Production Settings
WORKERS=4
ENVIRONMENT=development