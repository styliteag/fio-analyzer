{
  "name": "FIO Analyzer API",
  "version": "1.0.0",
  "base_urls": {
    "backend": "http://localhost:8000",
    "nginx_api_base": "http://localhost/api"
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/compare",
      "auth": "none",
      "summary": "Compare Storage Combinations"
    },
    {
      "method": "GET",
      "path": "/api/dashboard/stats",
      "auth": "none",
      "summary": "Get Dashboard Statistics"
    },
    {
      "method": "GET",
      "path": "/api/filters",
      "auth": "none",
      "summary": "Get Filter Options"
    },
    {
      "method": "POST",
      "path": "/api/import",
      "auth": "uploader",
      "summary": "Import FIO Test Data"
    },
    {
      "method": "GET",
      "path": "/api/import-log",
      "auth": "none",
      "summary": "List Upload Attempts"
    },
    {
      "method": "GET",
      "path": "/api/import-log/runs/{run_uuid}",
      "auth": "none",
      "summary": "Upload Completeness of a Run"
    },
    {
      "method": "POST",
      "path": "/api/import/bulk",
      "auth": "admin",
      "summary": "Bulk Import FIO Data"
    },
    {
      "method": "GET",
      "path": "/api/info",
      "auth": "none",
      "summary": "Get API Information"
    },
    {
      "method": "GET",
      "path": "/api/raw/runs/{run_uuid}",
      "auth": "none",
      "summary": "Download Run as ZIP"
    },
    {
      "method": "GET",
      "path": "/api/raw/test-runs/{test_run_id}",
      "auth": "none",
      "summary": "Download Raw FIO JSON"
    },
    {
      "method": "GET",
      "path": "/api/saturation/runs/{run_uuid}/summary",
      "auth": "none",
      "summary": "Saturation Summary of a Run"
    },
    {
      "method": "GET",
      "path": "/api/test-runs",
      "auth": "none",
      "summary": "Get Test Runs"
    },
    {
      "method": "PUT",
      "path": "/api/test-runs/bulk",
      "auth": "admin",
      "summary": "Bulk Update Test Runs"
    },
    {
      "method": "PUT",
      "path": "/api/test-runs/bulk-by-uuid",
      "auth": "admin",
      "summary": "Bulk Update Test Runs by UUID"
    },
    {
      "method": "GET",
      "path": "/api/test-runs/grouped-by-uuid",
      "auth": "none",
      "summary": "Get Test Runs Grouped by UUID"
    },
    {
      "method": "GET",
      "path": "/api/test-runs/performance-data",
      "auth": "none",
      "summary": "Get Performance Data"
    },
    {
      "method": "GET",
      "path": "/api/test-runs/saturation-data",
      "auth": "none",
      "summary": "Get Saturation Test Data"
    },
    {
      "method": "GET",
      "path": "/api/test-runs/saturation-runs",
      "auth": "none",
      "summary": "List Saturation Test Runs"
    },
    {
      "method": "PUT",
      "path": "/api/test-runs/saturation-runs/bulk-by-uuid",
      "auth": "admin",
      "summary": "Bulk Update Saturation Runs by UUID"
    },
    {
      "method": "DELETE",
      "path": "/api/test-runs/saturation-runs/by-uuid",
      "auth": "admin",
      "summary": "Delete Saturation Runs by UUID"
    },
    {
      "method": "DELETE",
      "path": "/api/test-runs/{test_run_id}",
      "auth": "admin",
      "summary": "Delete Test Run"
    },
    {
      "method": "GET",
      "path": "/api/test-runs/{test_run_id}",
      "auth": "none",
      "summary": "Get Single Test Run"
    },
    {
      "method": "PUT",
      "path": "/api/test-runs/{test_run_id}",
      "auth": "admin",
      "summary": "Update Test Run"
    },
    {
      "method": "GET",
      "path": "/api/time-series/all",
      "auth": "none",
      "summary": "Get All Historical Data"
    },
    {
      "method": "PUT",
      "path": "/api/time-series/bulk",
      "auth": "admin",
      "summary": "Bulk Update Time Series Data"
    },
    {
      "method": "DELETE",
      "path": "/api/time-series/delete",
      "auth": "admin",
      "summary": "Delete Time Series Data"
    },
    {
      "method": "GET",
      "path": "/api/time-series/history",
      "auth": "none",
      "summary": "Get Historical Time Series"
    },
    {
      "method": "POST",
      "path": "/api/time-series/history/cleanup",
      "auth": "admin",
      "summary": "Execute Historical Data Cleanup"
    },
    {
      "method": "GET",
      "path": "/api/time-series/history/cleanup-preview",
      "auth": "admin",
      "summary": "Preview Historical Data Cleanup"
    },
    {
      "method": "GET",
      "path": "/api/time-series/latest",
      "auth": "none",
      "summary": "Get Latest Time Series Data"
    },
    {
      "method": "GET",
      "path": "/api/time-series/servers",
      "auth": "none",
      "summary": "Get Server List"
    },
    {
      "method": "GET",
      "path": "/api/time-series/trends",
      "auth": "none",
      "summary": "Get Performance Trends"
    },
    {
      "method": "GET",
      "path": "/api/users",
      "auth": "admin",
      "summary": ""
    },
    {
      "method": "POST",
      "path": "/api/users",
      "auth": "admin",
      "summary": ""
    },
    {
      "method": "GET",
      "path": "/api/users/me",
      "auth": "auth",
      "summary": ""
    },
    {
      "method": "DELETE",
      "path": "/api/users/{username}",
      "auth": "admin",
      "summary": ""
    },
    {
      "method": "GET",
      "path": "/api/users/{username}",
      "auth": "admin",
      "summary": ""
    },
    {
      "method": "PUT",
      "path": "/api/users/{username}",
      "auth": "admin",
      "summary": ""
    },
    {
      "method": "GET",
      "path": "/health",
      "auth": "none",
      "summary": ""
    }
  ]
}